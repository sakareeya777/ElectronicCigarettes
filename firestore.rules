rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
match /news/{docId} {
allow read: if true;
allow write: if request.auth != null && request.auth.token.admin == true;
}
match /reportc/{docId} {
allow read: if true;
allow write: if request.auth != null;
}
match /authen/{docId} {
allow read: if true;
allow write: if request.auth != null;
}
}
}